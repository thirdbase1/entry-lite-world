{
  "name": "@entrylite/world",
  "version": "1.0.0",
  "description": "Entry-Lite production World for the Vercel Workflow SDK — plain node-postgres, no drizzle/graphile. Entry-Lite's own durable backend.",
  "license": "MIT",
  "author": "Miracle <miraclethirdbase1@gmail.com> (https://github.com/thirdbase1)",
  "contributors": [
    "Miracle <miraclethirdbase1@gmail.com> (https://github.com/thirdbase1)"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bootstrap": "./dist/bootstrap.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/schema.sql dist/schema.sql",
    "test": "ENTRYLITE_WORLD_URL=${ENTRYLITE_WORLD_URL:-postgres://world:world@127.0.0.1:5432/workflow} node --test test/*.test.mjs"
  },
  "dependencies": {
    "@workflow/errors": "5.0.5",
    "@workflow/world": "5.0.5",
    "pg": "^8.20.0",
    "ulid": "^3.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  }
}
